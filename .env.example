# Copier en .env (jamais commite) et adapter au plan d'adressage de la table.
SENTINEL_NODE_ID=SENTINEL-X-01

# Backend FORTEX (scripts/backend.py). Vide = alertes affichees en console seulement.
SENTINEL_API_URL=http://localhost:8080
# Jeton partage IA <-> backend : generer une valeur aleatoire dans .env (jamais commitee)
SENTINEL_API_TOKEN=
# Jeton de l'operateur (dashboard) : individus, vision, buzzer/LED ; ne peut pas emettre d'alertes
FORTEX_DASHBOARD_TOKEN=
SENTINEL_API_CA_CERT=

# Broker Mosquitto du depot infra : MQTTS (TLS) + compte obligatoire.
# Certificat et mots de passe generes par infra/scripts/gen-certs.sh et gen-mqtt-users.sh
SENTINEL_MQTT_HOST=localhost
SENTINEL_MQTT_PORT=8883
SENTINEL_MQTT_TOPIC=sentinel/+/sensors,fortex/capteurs/mesures
SENTINEL_MQTT_USER=serveur
SENTINEL_MQTT_PASSWORD=
SENTINEL_MQTT_CA_CERT=infra/certs/ca.crt
# Compte du boitier, utilise par scripts/fake_esp.py (seul autorise a publier des mesures)
ESP_MQTT_USER=esp8266
ESP_MQTT_PASSWORD=

# Flux video pour le dashboard : VITE_CAMERA_URL=http://<ip-serveur>:8081/video
SENTINEL_STREAM_PORT=8081
