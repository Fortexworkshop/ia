# Copier en .env (jamais commite) et adapter au plan d'adressage de la table.
SENTINEL_NODE_ID=SENTINEL-X-01

# API backend de l'equipe DEV (vide tant qu'elle n'existe pas = alertes affichees en console)
SENTINEL_API_URL=
SENTINEL_API_TOKEN=
SENTINEL_API_CA_CERT=

# Broker Mosquitto du depot Fortexworkshop/infra (docker compose up -d)
# Etat actuel de l'infra : port 1883, sans TLS ni mot de passe.
# Quand CYBER active MQTTS : port 8883 + SENTINEL_MQTT_CA_CERT=certs/ca.crt
SENTINEL_MQTT_HOST=localhost
SENTINEL_MQTT_PORT=1883
SENTINEL_MQTT_TOPIC=sentinel/+/sensors
SENTINEL_MQTT_USER=
SENTINEL_MQTT_PASSWORD=
SENTINEL_MQTT_CA_CERT=

# Flux video pour le dashboard : VITE_CAMERA_URL=http://<ip-serveur>:8081/video
SENTINEL_STREAM_PORT=8081
