# Variables lues par le dashboard. Copie de reference de dev/dashboard/.env, ecrite par
# scripts/configure.py : ne jamais y mettre de valeur reelle.
#
# Vide = simulateur local integre. Renseigner l'URL du backend FORTEX pour travailler en reel.
VITE_API_URL=
# Flux de la webcam servi par le PC serveur (ex. MJPEG). Vide = page camera sans flux.
VITE_CAMERA_URL=
# Grafana (infra/grafana, http://localhost:3001) : historique long et supervision technique.
# Vide = le lien vers Grafana n'apparait pas dans l'interface.
VITE_GRAFANA_URL=
# Code operateur : TOUJOURS VIDE. Une variable VITE_* est compilee dans le JavaScript, donc
# lisible par quiconque ouvre la page (OWASP A07). L'operateur saisit le code a la connexion ;
# il ne quitte jamais le sessionStorage du navigateur.
VITE_DASHBOARD_TOKEN=

