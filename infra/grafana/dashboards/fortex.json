    {
      "type": "table",
      "title": "Dernieres alertes",
      "id": 15,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fortex-pg"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
