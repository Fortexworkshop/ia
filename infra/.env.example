POSTGRES_DB=fortex
POSTGRES_USER=fortex
POSTGRES_PASSWORD=CHANGE_ME

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MQTT_HOST=mosquitto
MQTT_PORT=8883

# Racine du depot (contient backend/Dockerfile), relative a ce dossier
IA_DIR=..
# Jeton partage IA <-> backend (POST /api/v1/alerts) : generer une valeur aleatoire
API_TOKEN=CHANGE_ME
# Mots de passe MQTT : recopier depuis mqtt-users.env (genere par scripts/gen-mqtt-users.sh)
SERVEUR_MQTT_PASSWORD=CHANGE_ME
ESP_MQTT_PASSWORD=CHANGE_ME
CORS_ORIGINS=http://localhost:5173
# Jeton de l'operateur (dashboard) : individus, vision, buzzer/LED. Different du jeton de l'IA.
DASHBOARD_TOKEN=CHANGE_ME
# Grafana (supervision / MCO) : http://localhost:3001 , compte admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Compte PostgreSQL en lecture seule utilise par Grafana
GRAFANA_DB_PASSWORD=CHANGE_ME
